#!/usr/bin/env python3
"""cfq-tunnel: keep a Cloudflare quick tunnel alive and publish its address."""

import os
import sys

# Make the package importable whether this file is run directly or through a symlink.
script_dir = os.path.dirname(os.path.realpath(__file__))
if script_dir not in sys.path:
    sys.path.insert(0, script_dir)

from cfq_tunnel.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
